# Copy to .env (git-ignored) and fill in, then run: ./scripts/setup.sh

# Apple Developer Team ID: developer.apple.com > Account > Membership details (10 characters)
APPLE_TEAM_ID=

# Unique app ID. Use your own reverse-domain name, e.g. com.yourname.lyricdash
BUNDLE_ID=com.yourname.lyricdash

# App Group shared by the app and its widget. Must start with "group."
APP_GROUP_ID=group.com.yourname.lyricdash

# Spotify: developer.spotify.com/dashboard > your app > Settings > Client ID
SPOTIFY_CLIENT_ID=
